# Secrets et certificats
config.json
*.pem
autorite.crt

# Données patient et traces d'exécution
bilans/
Bilan_entrants/
journal.log
journal.log.*
technique.log
technique.log.*

# Documents internes : prix, marges, analyse concurrentielle
docs/projection.md

# Dépendances et archives de distribution
node_modules/
BilanPosturo-*.zip
# Le dossier que `outils/faire-paquet.sh` assemble avant de le compresser :
# sans cette ligne, un `git add -A` après fabrication d'un paquet verserait
# une copie complète de formulaire/ et serveur/ dans le dépôt.
BilanPosturo-*/

# Système
.DS_Store

# Python
__pycache__/
*.pyc

#claude

.claude/**

# Clés privées de l'éditeur : signature des mises à jour (C5) et des
# licences (C8). Elles ne vivent jamais dans le dépôt ; la CI refuse aussi
# ces motifs s'ils étaient forcés dans l'index.
cles-editeur/
*.key

# Fiches de démonstration faites pour un prospect : elles reprennent son
# protocole, qui n'a pas à être publié sans son accord.
fiche_presentation.html
